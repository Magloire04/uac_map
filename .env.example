# Copier ce fichier en .env puis adapter. Le fichier .env n'est jamais versionné.
# En production, ce même fichier (droits 600) est lu par l'application et par les commandes : voir docs/deployment.md.

# Environnement : vide en local, « production » en ligne (variables obligatoires plus strictes).
NODE_ENV=

# Base MariaDB (SQL compatible MySQL 8). WampServer : MariaDB écoute sur le port 3307 quand MySQL est aussi installé.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=uac_map
DATABASE_USER=uac_map
# Obligatoire en production. Jamais dans le code ni dans Git.
DATABASE_PASSWORD=

# Port HTTP du serveur.
PORT=3000

# Jeton d'accès au mode collecte (18 caractères au minimum). Obligatoire en production. Laisser vide en local :
# un jeton est alors généré au premier lancement dans data/.admin-token.
ADMIN_TOKEN=

# Adresse publique de l'appli, encodée dans les QR codes « Vous êtes ici ». Obligatoire en production.
PUBLIC_URL=

# Proxys de confiance (réglage « trust proxy » d'Express) : loopback par défaut, true, false, un nombre de proxys
# ou des adresses séparées par des virgules. Sert à connaître l'adresse du client et à détecter le HTTPS.
TRUST_PROXY=loopback

# Serveur HTTPS auto-signé en plus du HTTP, pour tester le GPS depuis un téléphone du même réseau (local uniquement).
HTTPS_ENABLED=false
HTTPS_PORT=3443

# Serveur Overpass utilisé par npm run import-osm.
OVERPASS_URL=https://overpass-api.de/api/interpreter
