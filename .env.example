# Copier ce fichier en .env puis adapter. Le fichier .env n'est jamais versionné.

# Port HTTP du serveur.
PORT=3000

# Jeton d'accès au mode collecte (18 caractères aléatoires ou plus). Laisser vide en local :
# un jeton est alors généré au premier lancement dans data/.admin-token. En production, le fournir ici
# ou via le gestionnaire de secrets de l'hébergement, jamais dans le code.
ADMIN_TOKEN=

# Adresse publique de l'appli, encodée dans les QR codes « Vous êtes ici ». Ex. https://carte.exemple.bj
PUBLIC_URL=

# Fichier de données de la carte (lieux et chemins).
DATA_FILE=data/campus.json

# Serveur HTTPS auto-signé en plus du HTTP, pour tester le GPS depuis un téléphone du même réseau.
HTTPS_ENABLED=false
HTTPS_PORT=3443

# Serveur Overpass utilisé par npm run import-osm.
OVERPASS_URL=https://overpass-api.de/api/interpreter
