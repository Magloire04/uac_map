# Base MariaDB réservée aux tests d'intégration. Son nom doit se terminer par _test : les tests vident ses tables.
# WampServer : MariaDB écoute sur le port 3307 quand MySQL est aussi installé.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=uac_map_test
DATABASE_USER=uac_map
DATABASE_PASSWORD=
